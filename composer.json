{
    "name": "sifrious/aleph-connector-pigeonpost",
    "description": "A deliberately odd sample Aleph connector: a pigeon courier network.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4.1",
        "sifrious/aleph": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Sifrious\\PigeonPost\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sifrious\\PigeonPost\\PigeonPostServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../Aleph",
            "options": { "symlink": true }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
